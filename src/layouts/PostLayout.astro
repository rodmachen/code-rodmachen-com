---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    date: string | Date;
    tags?: string[];
    subTitle?: string;
    accentColor?: string;
  }
}

const { frontmatter } = Astro.props;
const { title, date, tags = [], subTitle, accentColor = "var(--accent)" } = frontmatter;

// Formatting date
const dateObj = typeof date === 'string' ? new Date(date) : date;
const formattedDate = dateObj.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${title} | code.rodmachen.com`} description={subTitle}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title" style={`--post-accent: ${accentColor}`}>{title}</h1>
      {subTitle && <p class="post-subtitle">{subTitle}</p>}
      <div class="post-meta">
        <time datetime={dateObj.toISOString()}>{formattedDate}</time>
        {tags.length > 0 && (
          <span class="post-tags">
            &bull; {tags.map(tag => <span class="tag">{tag}</span>)}
          </span>
        )}
      </div>
    </header>
    
    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2rem;
  }
  
  .post-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    margin-top: 0;
    color: var(--post-accent);
  }
  
  .post-subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  
  .post-meta {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  
  .post-tags {
    margin-left: 0.5rem;
  }
  
  .tag {
    background-color: transparent;
    padding: 0.1rem 0.4rem;
    border-radius: 0;
    border: 1px solid var(--border);
    margin-right: 0.5rem;
    font-size: 0.8rem;
  }
  
  .post-content {
    font-size: 1.125rem;
  }
</style>
