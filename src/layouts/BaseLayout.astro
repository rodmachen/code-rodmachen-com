---
import '../styles/global.css';
import '../styles/classic.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = "code.rodmachen.com", description = "Tech and code writing by Rod Machen" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Twitter meta tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <div class="content classic-window">
      <h1 class="title">code.rodmachen.com</h1>
      
      <!-- Classic OS window controls -->
      <div class="control-box close-box"><a class="control-box-inner" href="/" aria-label="Home"></a></div>
      <div class="control-box zoom-box"><div class="zoom-box-inner" aria-label="Zoom"></div></div>
      <div class="control-box windowshade-box"><div class="windowshade-box-inner" aria-label="Collapse"></div></div>
      
      <div class="inner window-pane">
        <header>
          <div class="header-inner">
            <div class="site-title">
              <a href="/">Terminal</a>
            </div>
            <div class="header-links">
              <a href="https://rodmachen.com">Rod Machen</a>
            </div>
          </div>
        </header>
        
        <main>
          <slot />
        </main>
        
        <footer>
          <p>
            &copy; {new Date().getFullYear()} Rod Machen. 
            Part of <a href="https://rodmachen.com">rodmachen.com</a> | 
            <a href="https://edition.rodmachen.com">edition</a> | 
            <a href="https://photo.rodmachen.com">photo</a>
          </p>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  /* Override classic.css defaults to make it fit a modern blog */
  .classic-window {
    width: 95% !important;
    max-width: 800px;
    margin: 40px auto !important;
    /* Use the font for the window frame but let global handle content */
    font-family: 'ChicagoFLF', sans-serif;
  }
  
  .window-pane {
    background-color: var(--bg) !important;
    padding: 2rem;
    font-family: var(--font-sans); /* Use modern font for readability */
    font-size: 1.1rem; /* Better base size than the 12px from classic.css */
    color: var(--text);
  }
  
  /* Reset some of classic.css aggressive overrides that hurt readability */
  .window-pane h1, .window-pane h2, .window-pane h3 {
    margin-top: 1.5rem;
    margin-bottom: 1rem;
    font-weight: normal; /* Chicago shouldn't be bolded artificially */
  }
  
  /* Make sure the header looks nice inside the pane */
  header {
    margin-top: 0;
    padding-top: 0;
  }
</style>
