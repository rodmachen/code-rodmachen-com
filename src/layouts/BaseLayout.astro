---
import '../styles/global.css';
import '../styles/classic.css';
import MenuBar from '../components/MenuBar.astro';
import DesktopIcons from '../components/DesktopIcons.astro';
import AboutSiteModal from '../components/modals/AboutSiteModal.astro';
import AboutModal from '../components/modals/AboutModal.astro';
import ContactModal from '../components/modals/ContactModal.astro';
import ArchiveModal from '../components/modals/ArchiveModal.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = "code.rodmachen.com", description = "Tech and code writing by Rod Machen" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="bg-os8-bondi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Twitter meta tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <style>
      /* Window Controls Usability & Fixes */
      .control-box {
        cursor: pointer;
        width: 14px;
        height: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .zoom-box-inner, .windowshade-box-inner {
        margin: auto;
      }

      /* Override classic.css defaults to make it fit a modern blog.
         Use #main-window (ID) to guarantee specificity over classic.css .content */
      #main-window {
        width: 95%;
        max-width: 1000px;
        margin: 24px auto 0 auto; /* flush under 24px menu bar */
        height: calc(100vh - 24px); /* fill to bottom of viewport */
        display: flex;
        flex-direction: column;
        font-family: 'ChicagoFLF', sans-serif;
        transition: all 0.2s ease;
        box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.5); /* drop shadow */
      }

      #main-window.maximized {
        width: 100%;
        max-width: none;
        height: calc(100vh - 24px);
        margin: 24px 0 0 0;
        box-shadow: none; /* no shadow when maximized */
      }

      #main-window.shaded {
        height: auto;
      }

      div.window-pane {
        background-color: var(--bg);
        padding: 2rem;
        font-family: var(--font-sans); /* Use modern font for readability */
        font-size: 1.1rem; /* Better base size than the 12px from classic.css */
        color: var(--text);
        /* Make the inner pane the scrolling element */
        flex: 1;
        overflow-y: auto;
        /* Firefox fallback */
        scrollbar-width: auto;
        scrollbar-color: #eeeeee #cccccc;
      }

      /* Reset some of classic.css aggressive overrides that hurt readability */
      .window-pane h1, .window-pane h2, .window-pane h3 {
        margin-top: 1.5rem;
        margin-bottom: 1rem;
        font-weight: normal; /* Chicago shouldn't be bolded artificially */
      }

      /* Custom Platinum Scrollbars for the Window Pane */
      div.window-pane::-webkit-scrollbar {
        width: 16px;
        background-color: #cccccc;
        border-left: 1px solid #000000;
      }
      div.window-pane::-webkit-scrollbar-thumb {
        background-color: #eeeeee;
        border: 1px solid #000000;
        box-shadow: inset 1px 1px 0px #ffffff, inset -1px -1px 0px #aaaaaa;
      }
      div.window-pane::-webkit-scrollbar-thumb:active {
        background-color: #cccccc;
        box-shadow: inset 1px 1px 0px #aaaaaa, inset -1px -1px 0px #ffffff;
      }
      div.window-pane::-webkit-scrollbar-button:single-button:vertical:decrement {
        height: 16px;
        width: 16px;
        background-color: #eeeeee;
        border: 1px solid #000000;
        box-shadow: inset 1px 1px 0px #ffffff, inset -1px -1px 0px #aaaaaa;
        background-image: linear-gradient(to right, transparent 7px, black 7px, black 9px, transparent 9px), linear-gradient(to top, black 50%, transparent 50%);
        background-size: 16px 16px;
      }
      div.window-pane::-webkit-scrollbar-button:single-button:vertical:increment {
        height: 16px;
        width: 16px;
        background-color: #eeeeee;
        border: 1px solid #000000;
        box-shadow: inset 1px 1px 0px #ffffff, inset -1px -1px 0px #aaaaaa;
      }
    </style>
  </head>
  <body>
    <MenuBar />
    <DesktopIcons />

    <div class="content classic-window" id="main-window">
      <h1 class="title">code.rodmachen.com</h1>

      <!-- Classic OS window controls -->
      <button class="control-box close-box" onclick="window.location='/'" aria-label="Close window"><div class="control-box-inner" aria-hidden="true"></div></button>
      <button class="control-box zoom-box" id="btn-zoom" aria-label="Zoom window"><div class="control-box-inner" aria-hidden="true"><div class="zoom-box-inner"></div></div></button>
      <button class="control-box windowshade-box" id="btn-shade" aria-label="Collapse window"><div class="control-box-inner" aria-hidden="true"><div class="windowshade-box-inner"></div></div></button>

      <div class="inner window-pane" id="window-pane">
        <main>
          <slot />
        </main>

        <footer>
          <p>
            &copy; {new Date().getFullYear()} Rod Machen.
            Part of <a href="https://rodmachen.com">rodmachen.com</a> |
            <a href="https://edition.rodmachen.com">edition</a> |
            <a href="https://photo.rodmachen.com">photo</a>
          </p>
        </footer>
      </div>
    </div>

    <!-- Modal backdrop (click-catcher, hidden by default) -->
    <div class="modal-backdrop" id="modal-backdrop" hidden aria-hidden="true"></div>

    <!-- Modal sub-windows (hidden by default, shown via classic-ui.ts) -->
    <AboutSiteModal />
    <AboutModal />
    <ContactModal />
    <ArchiveModal />

    <script>
      import '../scripts/classic-ui.ts';
    </script>
  </body>
</html>
