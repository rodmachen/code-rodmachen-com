---
// SubWindow — reusable classic Mac OS modal window
// Usage: <SubWindow id="modal-foo" title="Window Title"><content /></SubWindow>
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div
  id={id}
  class="sub-window content classic-window"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
  hidden
>
  <h2 id={`${id}-title`} class="title">{title}</h2>

  <!-- Close box (top-left) -->
  <button
    class="control-box close-box"
    data-close-modal
    aria-label="Close window"
  ><div class="control-box-inner" aria-hidden="true"></div></button>

  <div class="inner window-pane sub-window-pane">
    <slot />
  </div>
</div>

<style>
  .sub-window {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 440px;
    max-width: 95vw;
    max-height: 70vh;
    z-index: 500;
    display: flex;
    flex-direction: column;
    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.6);
    font-family: 'ChicagoFLF', sans-serif;
  }
  .sub-window[hidden] {
    display: none;
  }
  .sub-window-pane {
    overflow-y: auto;
    padding: 1.5rem;
    font-family: 'Geneva', 'Arial', sans-serif;
    font-size: 0.95rem;
    background-color: #fff;
    flex: 1;
  }
</style>
