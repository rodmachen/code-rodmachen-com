---
// MenuBar component — classic Mac OS menu bar (static, no dropdowns yet)
---

<nav class="classic-menu-bar" aria-label="Main Navigation">
  <div class="menu-items">
    <span class="apple-logo">
      <img src="/img/apple-logo.svg" alt="Apple Menu" width="14" height="17" />
    </span>
    <a href="/" class="menu-item active">File</a>
    <span class="menu-item" aria-hidden="true">Edit</span>
    <span class="menu-item" aria-hidden="true">View</span>
    <span class="menu-item" aria-hidden="true">Special</span>
    <span class="menu-item" aria-hidden="true">Help</span>
  </div>
  <div class="menu-clock" id="menu-clock" aria-hidden="true">12:00 PM</div>
</nav>

<style>
  .classic-menu-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 24px;
    background-color: white;
    border-bottom: 1px solid black;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px;
    font-family: 'ChicagoFLF', sans-serif;
    font-size: 14px;
    z-index: 100;
  }
  .menu-items {
    display: flex;
    gap: 16px;
  }
  .menu-item {
    cursor: default;
    padding: 0 6px;
    color: black;
    text-decoration: none;
  }
  .menu-item.active,
  .menu-item:hover,
  .apple-logo:hover {
    background-color: black;
    color: white;
  }
  .apple-logo {
    cursor: default;
    padding: 0 6px;
    font-size: 16px;
  }
  .menu-clock {
    cursor: default;
    font-family: 'ChicagoFLF', sans-serif;
    font-size: 14px;
    line-height: 24px;
  }
</style>
