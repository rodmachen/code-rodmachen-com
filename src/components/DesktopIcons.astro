---
// DesktopIcons component — classic Mac OS 8.1 style right-side desktop icons
// Triggers for modals are handled by classic-ui.ts via data-modal
---

<!-- Main icon column (right side, below menu bar) -->
<div class="desktop-icons">
  <!-- Archive: opens posts list window -->
  <button type="button" class="desktop-icon" data-modal="modal-archive" aria-label="Open Archive">
    <img src="/img/icons/disk.svg" alt="" width="40" height="36" aria-hidden="true" />
    <span>Archive</span>
  </button>

  <!-- About: opens About modal (document icon, like "About Mac OS 8.1") -->
  <button type="button" class="desktop-icon" data-modal="modal-about" aria-label="Open About">
    <img src="/img/icons/doc.svg" alt="" width="32" height="40" aria-hidden="true" />
    <span>About</span>
  </button>

  <!-- Contact: opens Contact modal -->
  <button type="button" class="desktop-icon" data-modal="modal-contact" aria-label="Open Contact">
    <img src="/img/icons/mail.svg" alt="" width="40" height="32" aria-hidden="true" />
    <span>Contact</span>
  </button>
</div>

<!-- Trash: fixed at bottom-right -->
<div class="desktop-icon desktop-trash" aria-hidden="true">
  <img src="/img/icons/trash.svg" alt="" width="32" height="40" />
  <span>Trash</span>
</div>

<style>
  .desktop-icons {
    position: fixed;
    top: 40px;
    right: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    z-index: 50;
  }
  .desktop-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: white;
    font-family: 'Geneva', sans-serif;
    font-size: 11px;
    text-shadow:
      1px 1px 0 #000,
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000;
    width: 64px;
    text-align: center;
    cursor: pointer;
    /* reset button styles */
    background: none;
    border: none;
    padding: 2px;
    gap: 3px;
  }
  .desktop-icon:hover {
    color: #ffff00;
  }
  .desktop-icon:hover img {
    filter: brightness(0.7) sepia(1) saturate(5) hue-rotate(15deg);
  }
  .desktop-icon img {
    display: block;
    filter: drop-shadow(1px 1px 0px rgba(0, 0, 0, 0.5));
  }
  /* Trash: fixed at bottom-right, no hover effect */
  .desktop-trash {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 50;
    cursor: default;
  }
  .desktop-trash:hover {
    color: white;
  }
  .desktop-trash:hover img {
    filter: drop-shadow(1px 1px 0px rgba(0, 0, 0, 0.5));
  }
</style>
