---
// DesktopIcons component — classic Mac OS 8.1 style right-side desktop icons
// Triggers for modals are handled by classic-ui.ts via data-modal
---

<!-- Main icon column (right side, below menu bar) -->
<div class="desktop-icons">
  <!-- Archive: opens posts list window -->
  <button type="button" class="desktop-icon" data-modal="modal-archive" aria-label="Open Archive">
    <img src="/img/icons/disk.svg" alt="" width="40" height="30" aria-hidden="true" />
    <span>Archive</span>
  </button>

  <!-- About: opens About modal (document icon, like "About Mac OS 8.1") -->
  <button type="button" class="desktop-icon" data-modal="modal-about" aria-label="Open About">
    <img src="/img/icons/doc.svg" alt="" width="32" height="40" aria-hidden="true" />
    <span>About</span>
  </button>

  <!-- Contact: opens Contact modal -->
  <button type="button" class="desktop-icon" data-modal="modal-contact" aria-label="Open Contact">
    <img src="/img/icons/mail.svg" alt="" width="40" height="32" aria-hidden="true" />
    <span>Contact</span>
  </button>
</div>

<!-- Trash: fixed at bottom-right using inline style so scoped CSS cannot interfere -->
<div
  style="position:fixed;bottom:20px;right:20px;z-index:50;display:flex;flex-direction:column;align-items:center;gap:3px;width:64px;cursor:default;"
  aria-hidden="true"
>
  <img src="/img/icons/trash.svg" alt="" width="32" height="40"
    style="display:block;filter:drop-shadow(1px 1px 0px rgba(0,0,0,0.5));" />
  <span style="color:white;font-family:Geneva,sans-serif;font-size:11px;text-align:center;text-shadow:1px 1px 0 #000,-1px -1px 0 #000,1px -1px 0 #000,-1px 1px 0 #000;">Trash</span>
</div>

<style>
  .desktop-icons {
    position: fixed;
    top: 40px;
    right: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    z-index: 50;
  }
  .desktop-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: white;
    font-family: 'Geneva', sans-serif;
    font-size: 11px;
    text-shadow:
      1px 1px 0 #000,
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000;
    width: 64px;
    text-align: center;
    cursor: pointer;
    background: none;
    border: none;
    padding: 2px;
    gap: 3px;
  }
  .desktop-icon:hover {
    color: #ffff00;
  }
  .desktop-icon:hover img {
    filter: brightness(0.7) sepia(1) saturate(5) hue-rotate(15deg);
  }
  .desktop-icon img {
    display: block;
    filter: drop-shadow(1px 1px 0px rgba(0, 0, 0, 0.5));
  }
  /* "Opened" state: icon gets the classic Mac OS dithered/stippled look
     while its modal is open, via a 2x2 checker mask that hides every
     other pixel — the same trick System 7/Mac OS 8 used for open-disk icons. */
  .desktop-icon.icon--open img {
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='2' height='2'><rect width='1' height='1' fill='black'/><rect x='1' y='1' width='1' height='1' fill='black'/></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='2' height='2'><rect width='1' height='1' fill='black'/><rect x='1' y='1' width='1' height='1' fill='black'/></svg>");
    -webkit-mask-size: 2px 2px;
    mask-size: 2px 2px;
    -webkit-mask-repeat: repeat;
    mask-repeat: repeat;
    filter: drop-shadow(1px 1px 0px rgba(0, 0, 0, 0.5));
  }
  .desktop-icon.icon--open {
    color: #ccc;
  }
</style>
